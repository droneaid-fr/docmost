# Copy to .env (git-ignored), fill in, chmod 600. Never commit .env.
APP_URL=http://localhost:3000
# minimum 32 characters: openssl rand -hex 32
APP_SECRET=
# used by both the db service and the app's DATABASE_URL: openssl rand -hex 16
POSTGRES_PASSWORD=
STORAGE_DRIVER=local
JWT_TOKEN_EXPIRES_IN=30d
DISABLE_TELEMETRY=true
# Mail goes to the mailpit service (compose.yml sets SMTP_*); UI on http://localhost:8025
MAIL_FROM_ADDRESS=noreply@droneaid.local
MAIL_FROM_NAME=DroneAid Base (local)

# Translation with the fake Gemini service of compose.yml (tags text, does not translate).
# For real translations: put a real key in GEMINI_API_KEY and delete TRANSLATE_GEMINI_BASE_URL.
TRANSLATE_ENABLED=true
GEMINI_API_KEY=fake-key
TRANSLATE_GEMINI_BASE_URL=http://fake-gemini:8080/v1beta/models

# Google sign-in stays off locally: http://localhost:3000/api/droneaid/auth/google/callback
# is not registered on the real OAuth client.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Not read by Docmost; kept here so the secrets live in one untracked file.
# Agent token of "DroneAid France agent" (Settings -> Agents -> new token)
DOCMOST_AGENT_TOKEN=
# Local password of filipp@droneaid.fr (set through Forgot password + mailpit)
LOCAL_FILIPP_PASSWORD=
