# Copy to .env (git-ignored) and fill in. Never commit .env.
APP_URL=http://localhost:3000
# minimum 32 characters: openssl rand -hex 32
APP_SECRET=
# used by both the db service and the app's DATABASE_URL
POSTGRES_PASSWORD=
STORAGE_DRIVER=local
JWT_TOKEN_EXPIRES_IN=30d
DISABLE_TELEMETRY=true

# Mail (optional locally; e.g. a mailpit container on 1025)
MAIL_DRIVER=smtp
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=Docmost
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURE=false
