diff --git a/tests/test_doc_url.py b/tests/test_doc_url.py
new file mode 100644
index 0000000..a6f6d29
--- /dev/null
+++ b/tests/test_doc_url.py
@@ -0,0 +1,67 @@
+"""AffineClient.doc_url: the link import_pdf / import_csv hand back to the agent.
+
+Docmost reports `url` from create_document and get_document_info; AFFiNE
+reports neither, so its link is still built from the MCP endpoint.
+"""
+
+import json
+from types import SimpleNamespace
+
+import affine
+
+DOCMOST = "http://localhost:3300/api/droneaid/mcp"
+AFFINE = "https://base.example/api/workspaces/ws-1/mcp"
+
+
+class FakeSession:
+    def __init__(self, replies: dict):
+        self.replies = replies
+        self.calls: list[str] = []
+
+    async def call_tool(self, tool, arguments):
+        self.calls.append(tool)
+        reply = self.replies.get(tool)
+        if reply is None:
+            return SimpleNamespace(
+                content=[SimpleNamespace(type="text", text="Doc not found")],
+                isError=True,
+            )
+        return SimpleNamespace(
+            content=[SimpleNamespace(type="text", text=json.dumps(reply))],
+            isError=False,
+        )
+
+
+async def test_docmost_create_reply_url_is_used_without_another_call():
+    url = "http://localhost:3300/s/da-france/p/report-abc123"
+    session = FakeSession({"create_document": {"docId": "p1", "url": url}})
+    client = affine.AffineClient(session, DOCMOST)
+    doc_id = await client.create_document("Report", "x", None)
+    assert doc_id == "p1"
+    assert await client.doc_url(doc_id) == url
+    assert session.calls == ["create_document"]
+
+
+async def test_docmost_existing_doc_url_comes_from_get_document_info():
+    url = "http://localhost:3300/s/da-france/p/guests-xyz"
+    session = FakeSession({"get_document_info": {"id": "p2", "url": url}})
+    client = affine.AffineClient(session, DOCMOST)
+    assert await client.doc_url("p2") == url
+
+
+async def test_affine_falls_back_to_the_workspace_link():
+    session = FakeSession(
+        {"create_document": {"docId": "d1"}, "get_document_info": {"id": "d1"}}
+    )
+    client = affine.AffineClient(session, AFFINE)
+    doc_id = await client.create_document("T", "x", None)
+    assert await client.doc_url(doc_id) == "https://base.example/workspace/ws-1/d1"
+
+
+async def test_unknown_doc_on_docmost_has_no_link():
+    client = affine.AffineClient(FakeSession({}), DOCMOST)
+    assert await client.doc_url("missing") is None
+
+
+def test_doc_link_is_affine_only():
+    assert affine.doc_link(DOCMOST, "p1") is None
