# /opt/docmost/docmost.env: app configuration for the production stack (compose.yml
# `env_file`, read by the docmost and db containers). Copy, fill in, then:
#   chown ubuntu:ubuntu docmost.env && chmod 600 docmost.env
# (owned by the deploy user: `docker compose` reads env_file on the client side, and
# rollout.sh reads POSTGRES_USER/POSTGRES_DB from it).
# Never commit the filled file. Changes need `docker compose up -d` (not `restart`,
# which keeps the old environment).
#
# The image pointer is NOT here: /opt/docmost/.env holds only DOCMOST_IMAGE= and is
# written by the deploy workflow.

# ---- Core ------------------------------------------------------------------------
# Public origin, no trailing slash. Staging: https://<staging host>; after cutover:
# https://base.droneaid.fr. Links in mail, share pages and the Google callback derive
# from it.
APP_URL=
# >= 32 chars: openssl rand -hex 32. Signs every session and share/attachment token and
# keys the encryption of stored integration tokens. Keep it in the backup (backup.sh
# copies this file); changing it signs everybody out.
APP_SECRET=
# Session lifetime (default 90d). Also the lifetime of the cookie-bound sessions.
JWT_TOKEN_EXPIRES_IN=30d
# Docmost's anonymous usage ping: off.
DISABLE_TELEMETRY=true

# ---- Postgres (db service and the app) ---------------------------------------------
# The db container reads POSTGRES_*; DATABASE_URL must repeat the same password.
# Password: openssl rand -hex 24 (hex keeps the URL free of characters to escape).
POSTGRES_DB=docmost
POSTGRES_USER=docmost
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://docmost:<POSTGRES_PASSWORD>@db:5432/docmost
# Pool size per process (default 10).
# DATABASE_MAX_POOL=10

# ---- Redis (queues, collaboration fan-out, socket.io) -------------------------------
REDIS_URL=redis://redis:6379

# ---- Storage ----------------------------------------------------------------------
# compose.yml forces STORAGE_DRIVER=local; files land in /opt/docmost/data/storage.
STORAGE_DRIVER=local
# Per-file upload limit (default 50mb) and import limit (default 200mb).
# FILE_UPLOAD_SIZE_LIMIT=50mb
# FILE_IMPORT_SIZE_LIMIT=200mb

# ---- Mail: Resend SMTP ------------------------------------------------------------
# The sender must be on drone-aid.fr (hyphen): that is the domain verified in Resend;
# droneaid.fr is not and gets "403 domain is not verified".
MAIL_DRIVER=smtp
MAIL_FROM_ADDRESS=noreply@drone-aid.fr
MAIL_FROM_NAME=DroneAid Base
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_IGNORETLS=false
SMTP_USERNAME=resend
# A Resend API key with sending access only.
SMTP_PASSWORD=

# ---- Google sign-in (apps/server/src/droneaid/google-auth) --------------------------
# Both set = feature on. Register ${APP_URL}/api/droneaid/auth/google/callback on the
# OAuth client BEFORE APP_URL points at a new host (staging host first, then
# https://base.droneaid.fr/api/droneaid/auth/google/callback for cutover).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Translation of published pages (apps/server/src/droneaid/translate) ------------
# true = translate shared pages through Gemini. Leave false on staging unless testing it.
TRANSLATE_ENABLED=false
GEMINI_API_KEY=
# Default gemini-3.5-flash-lite.
# GEMINI_MODEL=
# Minutes without edits before an edited page is translated again (default 10).
# TRANSLATE_REFRESH_QUIET_MINUTES=10
# TRANSLATE_GEMINI_BASE_URL is for tests against a fake server only; never set it here.
